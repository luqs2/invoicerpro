VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key for admin panel cross-user queries (bypasses RLS)
# Get from: Supabase Dashboard > Settings > API > service_role (secret)
# ⚠️ NEVER commit this to git
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email is configured via Supabase Edge Function secrets (not .env)
# See EMAILJS_SETUP.md for Google SMTP setup instructions
